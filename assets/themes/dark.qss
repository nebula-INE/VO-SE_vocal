/* ============================================================================
   VO-SE Pro — Dark Theme (Studio Refined)
   デザイントークン（このファイル内で使う色の一覧・変更時はここだけ見ればよい）
   ----------------------------------------------------------------------------
   bg-base       #18181a   ウィンドウ最背面
   bg-panel      #1f1f22   ドック/パネル背景
   bg-elevated   #2a2a2e   入力欄・カード・ツールバー
   bg-hover      #34343a   ホバー時
   bg-pressed    #3d3d43   押下時
   border        #3a3a40   標準ボーダー
   border-strong #4a4a52   強調ボーダー
   accent        #0a84ff   プライマリアクセント（青）
   accent-hover  #2997ff
   accent-press  #0066cc
   danger        #ff453a   録音・警告
   success       #34c759
   text-primary  #f0f0f2
   text-secondary#9a9aa2
   text-disabled #55555c
   ============================================================================ */

/* --- ベース --- */
QMainWindow, QDialog {
    background-color: #18181a;
    color: #f0f0f2;
}
QWidget {
    font-family: "SF Pro Text", "Hiragino Kaku Gothic ProN", "Yu Gothic UI", "Segoe UI", sans-serif;
    font-size: 12.5px;
}
QFrame#centralWidget, QFrame#mainFrame {
    background-color: #18181a;
}
QFrame#TrackPanel {
    background-color: #1f1f22;
    border: none;
    border-right: 1px solid #303034;
}
QToolTip {
    background-color: #2a2a2e;
    color: #f0f0f2;
    border: 1px solid #4a4a52;
    padding: 4px 8px;
    border-radius: 4px;
}

/* --- ラベル --- */
QLabel {
    color: #d5d5da;
    background: transparent;
}
QLabel:disabled { color: #55555c; }

/* セクション見出し（例："TRACKS"） */
QLabel#SectionHeading {
    color: #7d7d86;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1px;
    padding: 4px 2px;
}

/* 等幅の時刻表示 */
QLabel#TimeDisplay {
    font-family: "SF Mono", "Menlo", "Consolas", monospace;
    font-weight: 600;
    font-size: 13px;
    color: #f0f0f2;
    background-color: #101012;
    border: 1px solid #303034;
    border-radius: 6px;
    padding: 3px 10px;
}

/* --- ボタン (標準) --- */
QPushButton {
    background-color: #2a2a2e;
    color: #f0f0f2;
    border: 1px solid #3a3a40;
    border-radius: 7px;
    padding: 6px 14px;
    font-size: 12.5px;
    font-weight: 500;
}
QPushButton:hover { background-color: #34343a; border-color: #4a4a52; }
QPushButton:pressed { background-color: #3d3d43; }
QPushButton:disabled { background-color: #1f1f22; color: #55555c; border-color: #2a2a2e; }
QPushButton:checkable:checked {
    background-color: #34343a;
    border-color: #0a84ff;
    color: #ffffff;
}

/* プライマリ（例: RENDER, テーマ切替の主導線） */
QPushButton#PrimaryButton, QPushButton#accentButton {
    background-color: #0a84ff;
    color: #ffffff;
    border: 1px solid #0a84ff;
    font-weight: 600;
}
QPushButton#PrimaryButton:hover, QPushButton#accentButton:hover { background-color: #2997ff; border-color: #2997ff; }
QPushButton#PrimaryButton:pressed, QPushButton#accentButton:pressed { background-color: #0066cc; border-color: #0066cc; }
QPushButton#PrimaryButton:disabled { background-color: #1f1f22; color: #55555c; border-color: #2a2a2e; }

/* セカンダリ（OPEN WAV, テーマ切替など） */
QPushButton#SecondaryButton {
    background-color: transparent;
    border: 1px solid #4a4a52;
    color: #d5d5da;
}
QPushButton#SecondaryButton:hover { background-color: #26262a; border-color: #626269; }

/* 録音ボタン専用（危険色） */
QPushButton#RecordButton {
    background-color: #2a2a2e;
    border: 1px solid #3a3a40;
    color: #f0f0f2;
}
QPushButton#RecordButton:hover { border-color: #ff453a; }
QPushButton#RecordButton:checked {
    background-color: rgba(255, 69, 58, 0.16);
    border-color: #ff453a;
    color: #ff6961;
}

/* セグメントコントロール（再生/停止/ループなど連結ボタン群） */
QPushButton#SegmentLeft, QPushButton#SegmentMid, QPushButton#SegmentRight {
    background-color: #2a2a2e;
    color: #d5d5da;
    border: 1px solid #3a3a40;
    border-right-width: 0px;
    border-radius: 0px;
    min-width: 76px;
    padding: 6px 12px;
}
QPushButton#SegmentRight { border-right-width: 1px; }
QPushButton#SegmentLeft { border-top-left-radius: 7px; border-bottom-left-radius: 7px; }
QPushButton#SegmentRight { border-top-right-radius: 7px; border-bottom-right-radius: 7px; }
QPushButton#SegmentLeft:hover, QPushButton#SegmentMid:hover, QPushButton#SegmentRight:hover { background-color: #34343a; }
QPushButton#SegmentLeft:checked, QPushButton#SegmentMid:checked, QPushButton#SegmentRight:checked {
    background-color: #0a84ff;
    color: #ffffff;
    border-color: #0a84ff;
}

/* パラメーター編集モード切替（Pitch/Gender/Tension/Breath）
   ── setStyleSheet直書きの代わりに動的プロパティ paramColor で色分け ── */
QPushButton[role="paramToggle"] {
    background-color: #2a2a2e;
    border: 1px solid #3a3a40;
    border-radius: 7px;
    color: #9a9aa2;
    font-weight: 600;
    padding: 5px 10px;
    min-width: 56px;
}
QPushButton[role="paramToggle"]:hover { background-color: #34343a; color: #f0f0f2; }
QPushButton[role="paramToggle"]:checked[paramColor="pitch"] {
    background-color: rgba(52, 152, 219, 0.18); border-color: #3498db; color: #6cb6ea;
}
QPushButton[role="paramToggle"]:checked[paramColor="gender"] {
    background-color: rgba(231, 76, 60, 0.18); border-color: #e74c3c; color: #ee8177;
}
QPushButton[role="paramToggle"]:checked[paramColor="tension"] {
    background-color: rgba(46, 204, 113, 0.18); border-color: #2ecc71; color: #6fdb9e;
}
QPushButton[role="paramToggle"]:checked[paramColor="breath"] {
    background-color: rgba(241, 196, 15, 0.18); border-color: #f1c40f; color: #f3d465;
}

/* --- ツールバー / ツールボタン (アイコン主体) --- */
QToolBar {
    background-color: #1f1f22;
    border: none;
    border-bottom: 1px solid #303034;
    spacing: 4px;
    padding: 5px 8px;
}
QToolBar::separator {
    background-color: #303034;
    width: 1px;
    margin: 4px 6px;
}
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 7px;
    padding: 5px;
    color: #d5d5da;
}
QToolButton:hover { background-color: #2a2a2e; border-color: #3a3a40; }
QToolButton:pressed { background-color: #34343a; }
QToolButton:checked { background-color: rgba(10, 132, 255, 0.18); border-color: #0a84ff; }

/* --- 入力フィールド --- */
QLineEdit, QTextEdit, QPlainTextEdit {
    background-color: #101012;
    color: #f0f0f2;
    border: 1px solid #3a3a40;
    border-radius: 7px;
    padding: 5px 9px;
    selection-background-color: #0a84ff;
    selection-color: #ffffff;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus { border: 1px solid #0a84ff; }
QLineEdit:disabled { color: #55555c; background-color: #1a1a1c; }

/* --- コンボボックス --- */
QComboBox {
    background-color: #2a2a2e;
    color: #f0f0f2;
    border: 1px solid #3a3a40;
    border-radius: 7px;
    padding: 4px 10px;
    min-width: 6em;
}
QComboBox:hover { background-color: #34343a; }
QComboBox:on { border-color: #0a84ff; }
QComboBox::drop-down { subcontrol-origin: padding; subcontrol-position: top right; width: 22px; border-left-width: 0px; }
QComboBox QAbstractItemView {
    background-color: #2a2a2e;
    color: #f0f0f2;
    border: 1px solid #3a3a40;
    selection-background-color: #0a84ff;
    selection-color: #ffffff;
    outline: none;
}

/* --- チェックボックス / ラジオボタン --- */
QCheckBox, QRadioButton { color: #d5d5da; spacing: 8px; background: transparent; }
QCheckBox::indicator, QRadioButton::indicator {
    width: 16px; height: 16px; border-radius: 4px; border: 1px solid #4a4a52; background-color: #2a2a2e;
}
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #6a6a72; }
QCheckBox::indicator:checked, QRadioButton::indicator:checked { background-color: #0a84ff; border-color: #0a84ff; }

/* --- スライダー --- */
QSlider::groove:horizontal { height: 4px; background: #3a3a40; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #0a84ff; border-radius: 2px; }
QSlider::handle:horizontal {
    background: #f0f0f2; width: 14px; height: 14px; margin: -5px 0; border-radius: 7px;
}
QSlider::handle:horizontal:hover { background: #ffffff; }
QSlider::groove:vertical { width: 4px; background: #3a3a40; border-radius: 2px; }
QSlider::add-page:vertical { background: #0a84ff; border-radius: 2px; }
QSlider::handle:vertical {
    background: #f0f0f2; width: 14px; height: 14px; margin: 0 -5px; border-radius: 7px;
}

/* --- スクロールバー --- */
QScrollBar:vertical { background: transparent; width: 10px; margin: 0px; }
QScrollBar::handle:vertical { background: #3a3a40; min-height: 24px; border-radius: 5px; margin: 1px; }
QScrollBar::handle:vertical:hover { background: #4a4a52; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0px; }
QScrollBar::handle:horizontal { background: #3a3a40; min-width: 24px; border-radius: 5px; margin: 1px; }
QScrollBar::handle:horizontal:hover { background: #4a4a52; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0px; height: 0px; border: none; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

/* --- タブウィジェット --- */
QTabWidget::pane { border: 1px solid #3a3a40; background-color: #18181a; top: -1px; }
QTabBar::tab {
    background-color: #2a2a2e; color: #7d7d86; padding: 6px 14px; margin-right: 2px;
    border-top-left-radius: 7px; border-top-right-radius: 7px;
}
QTabBar::tab:selected { background-color: #18181a; color: #f0f0f2; border: 1px solid #3a3a40; border-bottom-color: #18181a; }
QTabBar::tab:hover:!selected { background-color: #34343a; color: #f0f0f2; }

/* --- ドック / パネル --- */
QDockWidget {
    color: #d5d5da;
    titlebar-close-icon: none;
    border: none;
}
QDockWidget::title {
    background-color: #1f1f22;
    border-bottom: 1px solid #303034;
    padding: 7px 10px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 1px;
    color: #9a9aa2;
    text-transform: uppercase;
}
QDockWidget > QWidget { background-color: #1f1f22; }

/* --- リスト（トラック一覧など） --- */
QListWidget {
    background-color: #1f1f22;
    border: 1px solid #303034;
    border-radius: 8px;
    outline: none;
    padding: 3px;
}
QListWidget::item {
    color: #d5d5da;
    padding: 7px 8px;
    border-radius: 6px;
    margin: 1px 0;
}
QListWidget::item:hover { background-color: #2a2a2e; }
QListWidget::item:selected {
    background-color: rgba(10, 132, 255, 0.20);
    color: #ffffff;
    border: 1px solid #0a84ff;
}

/* --- メニュー --- */
QMenuBar { background-color: #1f1f22; color: #d5d5da; border-bottom: 1px solid #303034; }
QMenuBar::item { background: transparent; padding: 5px 10px; }
QMenuBar::item:selected { background-color: #2a2a2e; border-radius: 5px; }
QMenu {
    background-color: #2a2a2e; color: #f0f0f2; border: 1px solid #3a3a40; border-radius: 8px; padding: 4px;
}
QMenu::item { padding: 6px 22px; border-radius: 5px; }
QMenu::item:selected { background-color: #0a84ff; color: #ffffff; }
QMenu::separator { height: 1px; background: #3a3a40; margin: 4px 6px; }

/* --- ステータスバー --- */
QStatusBar {
    background-color: #1f1f22;
    border-top: 1px solid #303034;
    color: #9a9aa2;
}

/* --- スプリッター --- */
QSplitter::handle { background: #232326; }
QSplitter::handle:horizontal { width: 2px; }
QSplitter::handle:vertical { height: 2px; }
QSplitter::handle:hover { background: #0a84ff; }

/* --- グループボックス --- */
QGroupBox {
    border: 1px solid #3a3a40;
    border-radius: 8px;
    margin-top: 10px;
    padding-top: 12px;
    color: #d5d5da;
    font-weight: 600;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; color: #9a9aa2; }

/* --- プログレスバー --- */
QProgressBar {
    background-color: #101012;
    border: 1px solid #3a3a40;
    border-radius: 6px;
    text-align: center;
    color: #f0f0f2;
    height: 14px;
}
QProgressBar::chunk { background-color: #0a84ff; border-radius: 5px; }

/* --- ダイヤル（今後のパン/ゲインノブ用） --- */
QDial { background-color: transparent; }

/* --- トラックミキサーストリップ (TrackStripWidget) --- */
QFrame#TrackStrip {
    background-color: transparent;
    border-radius: 6px;
}
QFrame#TrackStrip:hover { background-color: #26262a; }
QFrame#TrackStrip[dimmed="true"] { opacity: 0.55; }

QFrame#TrackColorBar { border-radius: 2px; }

QLabel#TrackTypeBadge {
    font-size: 9.5px;
    font-weight: 700;
    border-radius: 4px;
    background-color: #34343a;
    color: #d5d5da;
}
QLabel#TrackTypeBadge[trackType="wave"] { background-color: rgba(100, 210, 255, 0.20); color: #64d2ff; }
QLabel#TrackTypeBadge[trackType="vocal"] { background-color: rgba(10, 132, 255, 0.20); color: #6cb6ea; }

QLineEdit#TrackNameField {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 1px 3px;
    color: #f0f0f2;
    font-weight: 600;
    font-size: 12px;
}
QLineEdit#TrackNameField:hover { background-color: #1a1a1c; border-color: #3a3a40; }
QLineEdit#TrackNameField:focus { background-color: #101012; border-color: #0a84ff; }

QPushButton#MuteBtn, QPushButton#SoloBtn {
    background-color: #2a2a2e;
    border: 1px solid #3a3a40;
    border-radius: 4px;
    color: #9a9aa2;
    font-size: 10px;
    font-weight: 700;
    padding: 0px;
}
QPushButton#MuteBtn:hover, QPushButton#SoloBtn:hover { background-color: #34343a; }
QPushButton#MuteBtn:checked { background-color: rgba(255, 69, 58, 0.22); border-color: #ff453a; color: #ff8a80; }
QPushButton#SoloBtn:checked { background-color: rgba(255, 214, 10, 0.22); border-color: #ffd60a; color: #ffe57f; }

QSlider#PanSlider::groove:horizontal { height: 3px; background: #3a3a40; border-radius: 1px; }
QSlider#PanSlider::handle:horizontal {
    background: #9a9aa2; width: 10px; height: 10px; margin: -4px 0; border-radius: 5px;
}
QSlider#PanSlider::handle:horizontal:hover { background: #f0f0f2; }

QSlider#VolumeFader::groove:horizontal { height: 4px; background: #3a3a40; border-radius: 2px; }
QSlider#VolumeFader::sub-page:horizontal { background: #0a84ff; border-radius: 2px; }
QSlider#VolumeFader::handle:horizontal {
    background: #f0f0f2; width: 11px; height: 14px; margin: -5px 0; border-radius: 3px;
}
QSlider#VolumeFader::handle:horizontal:hover { background: #ffffff; }

QLabel#VolumeReadout {
    font-family: "SF Mono", "Menlo", "Consolas", monospace;
    font-size: 10px;
    color: #7d7d86;
}

/* --- ボイスギャラリー検索/フィルター --- */
QLineEdit#SearchField {
    border-radius: 15px;
    padding: 6px 12px;
    background-color: #101012;
}
QPushButton#FilterChip {
    background-color: transparent;
    border: 1px solid #3a3a40;
    border-radius: 13px;
    padding: 4px 13px;
    font-size: 11.5px;
    font-weight: 600;
    color: #9a9aa2;
}
QPushButton#FilterChip:hover { background-color: #26262a; color: #f0f0f2; }
QPushButton#FilterChip:checked {
    background-color: rgba(10, 132, 255, 0.20);
    border-color: #0a84ff;
    color: #ffffff;
}
QLabel#GalleryEmptyState {
    color: #6a6a72;
    font-size: 13px;
    padding: 40px;
}

/* TrackStripWidget を埋め込む行だけpaddingをゼロにして、ストリップ自身に任せる */
QListWidget#TrackList::item {
    padding: 0px;
    margin: 2px 4px;
}
QListWidget#TrackList::item:selected {
    background-color: rgba(10, 132, 255, 0.14);
    border: 1px solid #0a84ff;
}
